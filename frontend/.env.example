# Backend API base URL (include /api/auth)
VITE_API_BASE_URL=https://your-backend.onrender.com/api/auth

# Socket.IO backend URL
VITE_SOCKET_URL=https://your-backend.onrender.com

# WebRTC ICE servers
VITE_STUN_URL=stun:stun.l.google.com:19302

# Optional TURN (strongly recommended in production)
VITE_TURN_URL=turn:your-turn-server:3478
VITE_TURN_USERNAME=turn_username
VITE_TURN_CREDENTIAL=turn_password
